# OpsPilot AI client: copy to client/.env for local development.
# Every VITE_* value is bundled into public browser code. Never put secrets here.

# Base path or URL for API requests (defaults to /api/v1)
VITE_API_BASE_URL=/api/v1

# Dev server only, not sent to the browser: where Vite proxies /api requests
# (defaults to http://localhost:3000). Must match the server's PORT.
API_PROXY_TARGET=http://localhost:3000
