# OpsPilot AI server: copy to server/.env for local development.
# Never commit .env files. Production values are set in the hosting dashboard.

# One of: development | test | production (defaults to development)
NODE_ENV=development
# Port the API listens on (defaults to 3000; Render sets this automatically)
PORT=3000

# MongoDB connection string. Required when NODE_ENV=production.
# Leave empty in development to run without a database. When set, the server will not
# start until it connects, and /api/v1/ready reports 503 while the connection is down.
# Local example (no credentials): mongodb://127.0.0.1:27017/opspilot
MONGODB_URI=

# Secret for signing session tokens. Required (at least 32 characters) when MONGODB_URI is set,
# because authentication is enabled together with the database. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# The browser origin allowed to make state-changing requests (CSRF protection).
# Defaults to the Vite dev server outside production; required (https) in production.
# Open the app at exactly this origin: http://127.0.0.1:5173 would be rejected.
CLIENT_ORIGIN=http://localhost:5173
