# OpsPilot AI server: copy to server/.env for local development.
# Never commit .env files. Production values are set in the hosting dashboard.

# One of: development | test | production (defaults to development)
NODE_ENV=development
# Port the API listens on (defaults to 3000; Render sets this automatically)
PORT=3000

# MongoDB connection string. Required when NODE_ENV=production.
# Leave empty in development to run without a database. When set, the server will not
# start until it connects, and /api/v1/ready reports 503 while the connection is down.
# Local example (no credentials): mongodb://127.0.0.1:27017/opspilot
MONGODB_URI=
