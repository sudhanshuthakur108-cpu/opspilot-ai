# OpsPilot AI: environment template
# Copy to .env and fill in values locally. Never commit real values.

# --- Server ---
NODE_ENV=development
PORT=
# Allowed frontend origin for CORS (e.g. the Vite dev server or Vercel URL)
CLIENT_ORIGIN=

# --- Database ---
MONGODB_URI=

# --- AI ---
# One of: mock | openai
AI_PROVIDER=mock
# Required only when AI_PROVIDER=openai (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Frontend (Vite exposes VITE_* vars to the browser: never put secrets here) ---
VITE_API_BASE_URL=
